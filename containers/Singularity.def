Bootstrap: docker
From: ubuntu:24.04

%labels
  Author yeast-rnaseq-nf
  Description Bioinformatics environment for yeast RNA-seq scaffold

%environment
  export LC_ALL=C
  export PATH=/usr/local/bin:$PATH

%post
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    fastp \
    gfortran \
    multiqc \
    pkg-config \
    samtools \
    subread \
    rna-star \
    wget \
    python3 \
    r-base \
    r-bioc-deseq2 \
    libcurl4-openssl-dev \
    libpng-dev \
    libssl-dev \
    libxml2-dev \
    zlib1g-dev \
    ca-certificates

  Rscript -e "suppressPackageStartupMessages(library(DESeq2)); cat(as.character(packageVersion('DESeq2')), '\n')"

  apt-get clean
  rm -rf /var/lib/apt/lists/*

%runscript
  exec "$@"
